diff -ruN a/src/backend/egl/ffi.rs b/src/backend/egl/ffi.rs
--- a/src/backend/egl/ffi.rs	2026-11-25 17:22:14.294382547 +0200
+++ b/src/backend/egl/ffi.rs	2026-11-25 17:22:14.686382547 +0200
@@ -145,7 +145,15 @@
     use std::sync::{LazyLock, Once};
 
     pub static LIB: LazyLock<Library> =
-        LazyLock::new(|| unsafe { Library::new("libEGL.so.1") }.expect("Failed to load LibEGL"));
+        LazyLock::new(|| unsafe { {
+            // Android: по имени dlopen находит по RUNPATH libEGL.so из Termux (Mesa без платформы Android),
+            // поэтому сначала берём системный EGL по абсолютному пути
+            #[cfg(target_os = "android")]
+            let first = Library::new("/system/lib64/libEGL.so");
+            #[cfg(not(target_os = "android"))]
+            let first = Library::new("libEGL.so.1");
+            first.or_else(|_| Library::new("libEGL.so.1")).or_else(|_| Library::new("libEGL.so"))
+        } }.expect("Failed to load LibEGL"));
 
     pub static LOAD: Once = Once::new();
     pub static DEBUG: Once = Once::new();
